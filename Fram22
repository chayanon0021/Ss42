      };

      const handleClearHistory = () => {
        if(window.confirm('⚠️ ต้องการเคลียร์ "โพยเก่า" และ "ผลรางวัลย้อนหลัง" เพื่อให้ระบบเร็วขึ้นใช่หรือไม่?\n\n(สมาชิก, เงินเครดิต และรายชื่อหวยจะยังอยู่ครบ)')) {
            ctx.setBetTickets([]);
            ctx.setCampaigns(prev => prev.map(c => ({...c, resultsHistory: []})));
