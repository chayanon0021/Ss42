    const AdminView = ({ ctx }) => {
      const [adminTab, setAdminTab] = useState('campaigns'); 
      const [selectedCamp, setSelectedCamp] = useState(null); 
      const [campTab, setCampTab] = useState('info'); 
      const [filterDate, setFilterDate] = useState(getTodayYYYYMMDD());
      
      const [newUser, setNewUser] = useState({ username: '', password: '', name: '', credit: '', commRates: {...DEFAULT_COMM_RATES} });
      const [showNewCommSetup, setShowNewCommSetup] = useState(false);

      const [editingUser, setEditingUser] = useState(null); 
      const [customCreditAmount, setCustomCreditAmount] = useState(''); 
      const [editingCommRates, setEditingCommRates] = useState({});

      const [newCampaign, setNewCampaign] = useState({ name: '', openTime: ctx.timeDefaults?.openTime || '', closeTime: ctx.timeDefaults?.closeTime || '' });
      const [blockInput, setBlockInput] = useState('');
      const [resultInput, setResultInput] = useState({ top3: '', bot2: '' });

      const handleCreateUser = (e) => {
        e.preventDefault();
        if (!newUser.username || !newUser.password || !newUser.name || !newUser.credit) return ctx.showNotification('กรุณากรอกให้ครบ');
        if ((ctx.usersDb || []).find(u => u?.username === newUser.username)) return ctx.showNotification('Username ซ้ำ!');
        
        ctx.setUsersDb(prev => [...prev, { uid: 'VIP' + Math.floor(1000 + Math.random() * 9000), username: newUser.username, password: newUser.password, name: newUser.name, credit: parseFloat(newUser.credit), commRates: newUser.commRates, role: 'user' }]);
        setNewUser({ username: '', password: '', name: '', credit: '', commRates: {...DEFAULT_COMM_RATES} });
        setShowNewCommSetup(false);
        ctx.showNotification('✅ สร้างสมาชิกสำเร็จ!');
      };

      const handleUpdateCredit = (uid, amount) => {
        ctx.setUsersDb(prev => prev.map(u => u?.uid === uid ? { ...u, credit: Math.max(0, (u.credit||0) + amount) } : u));
        setCustomCreditAmount('');
        ctx.showNotification('ปรับเครดิตสำเร็จ');
      };

      const handleUpdateComm = (uid) => {
        ctx.setUsersDb(prev => prev.map(u => u?.uid === uid ? { ...u, commRates: editingCommRates } : u));
        ctx.showNotification('บันทึกค่าคอมมิชชั่นสำเร็จ');
      };

      const handleAddCampaign = (e) => {
        e.preventDefault();
        if(!newCampaign.name || !newCampaign.openTime || !newCampaign.closeTime) return ctx.showNotification('กรุณาใส่ชื่อและเวลา');
        ctx.setTimeDefaults({ openTime: newCampaign.openTime, closeTime: newCampaign.closeTime });
        ctx.setCampaigns(prev => [{ id: Date.now(), name: newCampaign.name, openTime: newCampaign.openTime, closeTime: newCampaign.closeTime, status: 'active', blockedNumbers: [], payRates: JSON.parse(JSON.stringify(DEFAULT_PAY_RATES)), resultsHistory: [] }, ...prev]);
        setNewCampaign({ ...newCampaign, name: '' });
        ctx.showNotification('เพิ่มรอบหวยรายวันสำเร็จ');
      };

      const handleDeleteCampaign = (id) => {
        if(window.confirm('⚠️ ยืนยันการลบหวยรอบนี้? ข้อมูลหวยนี้จะหายไปจากระบบทันที')) {
          ctx.setCampaigns(prev => prev.filter(c => c.id !== id));
          ctx.showNotification('ลบหวยสำเร็จ');
        }
      }

      const updateActiveCamp = (updatedCamp) => {
        setSelectedCamp(updatedCamp); 
        ctx.setCampaigns(prev => prev.map(c => c?.id === updatedCamp.id ? updatedCamp : c));
      };

      const handleProcessResults = () => {
        const top3 = resultInput.top3.trim();
        const bot2 = resultInput.bot2.trim();
        if(top3.length !== 3 || bot2.length !== 2) return ctx.showNotification('กรุณากรอก 3ตัวบน และ 2ตัวล่าง ให้ถูกต้อง');

        const pendingTickets = (ctx.betTickets || []).filter(t => t?.campaignId === selectedCamp.id && t?.status === 'pending');
        let totalPayoutAll = 0;
        const winsPerUser = {};
        
        const processedTickets = pendingTickets.map(ticket => {
          if(!ticket) return null;
          let ticketWinAmount = 0;
          const newItems = (ticket.items || []).map(item => {
            if(!item) return null;
            let isWin = false;
            const betNum = item.number;
            if (item.typeId === '3_top' && betNum === top3) isWin = true;
            else if (item.typeId === '3_tod' && betNum.split('').sort().join('') === top3.split('').sort().join('')) isWin = true;
            else if (item.typeId === '2_top' && betNum === top3.slice(-2)) isWin = true;
            else if (item.typeId === '2_bot' && betNum === bot2) isWin = true;
            else if (item.typeId === '1_top' && top3.includes(betNum)) isWin = true;
            else if (item.typeId === '1_bot' && bot2.includes(betNum)) isWin = true;
            
            if (isWin) ticketWinAmount += (item.price || 0) * (item.pay || 0);
            return { ...item, isWin };
          });

          if (ticketWinAmount > 0) {
            totalPayoutAll += ticketWinAmount;
            winsPerUser[ticket.uid] = (winsPerUser[ticket.uid] || 0) + ticketWinAmount;
          }
          return { ...ticket, items: newItems, status: 'processed', totalWin: ticketWinAmount };
        });

        ctx.setUsersDb(prev => prev.map(u => {
          if(!u) return u;
          return winsPerUser[u.uid] ? { ...u, credit: (u.credit||0) + winsPerUser[u.uid] } : u;
        }));
        
        ctx.setBetTickets(prev => [...prev.filter(t => !(t?.campaignId === selectedCamp.id && t?.status === 'pending')), ...processedTickets]);
        
        const newResult = { id: Date.now(), dateStr: new Date().toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }), fullDate: new Date().toISOString(), top3, bot2 };
