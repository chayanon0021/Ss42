            window.localStorage.clear();
            ctx.showNotification('ล้างข้อมูลระบบเรียบร้อยแล้ว กำลังรีสตาร์ท...');
            setTimeout(() => window.location.reload(), 1000);
          }
        }
      }

      if (selectedCamp) {
        return (
          <div className="min-h-screen bg-[var(--bg-app)] text-[var(--text-primary)] pb-20">
            <div className="bg-[var(--bg-panel)] p-4 flex items-center gap-3 border-b border-[var(--border-color)] sticky top-0 z-10 shadow-sm">
              <button onClick={() => setSelectedCamp(null)} className="p-2 bg-[var(--bg-input)] rounded-lg border border-[var(--border-color)]"><i className="fas fa-chevron-left"></i></button>
              <div className="flex-1">
                <h2 className="font-bold truncate text-sm">{selectedCamp.name}</h2>
                <span className={`text-[10px] px-2 py-0.5 rounded font-bold ${selectedCamp.status === 'active' ? 'bg-green-500/10 text-[var(--text-success)]' : 'bg-red-500/10 text-[var(--text-danger)]'}`}>สถานะ: {selectedCamp.status === 'active' ? 'เปิดรับ (รายวัน)' : 'ปิดรับชั่วคราว'}</span>
              </div>
            </div>
            <div className="flex overflow-x-auto bg-[var(--bg-panel)] p-2 border-b border-[var(--border-color)] text-sm font-bold">
              <button onClick={() => setCampTab('info')} className={`px-4 py-2 rounded-lg whitespace-nowrap ${campTab==='info' ? 'bg-[var(--bg-input)] text-[var(--text-primary)]' : 'text-[var(--text-secondary)]'}`}>ข้อมูล</button>
              <button onClick={() => setCampTab('block')} className={`px-4 py-2 rounded-lg whitespace-nowrap ${campTab==='block' ? 'bg-red-500/10 text-[var(--text-danger)]' : 'text-[var(--text-secondary)]'}`}>เลขอั้น</button>
              <button onClick={() => setCampTab('rate')} className={`px-4 py-2 rounded-lg whitespace-nowrap ${campTab==='rate' ? 'bg-yellow-500/10 text-[var(--text-accent-bold)]' : 'text-[var(--text-secondary)]'}`}>อัตราจ่าย</button>
              <button onClick={() => setCampTab('result')} className={`px-4 py-2 rounded-lg whitespace-nowrap ${campTab==='result' ? 'bg-blue-500/10 text-[var(--text-info)]' : 'text-[var(--text-secondary)]'}`}>ออกผล</button>
            </div>
            <div className="p-4">
              {campTab === 'info' && (
                <div className="space-y-4">
                   <button onClick={() => updateActiveCamp({...selectedCamp, status: selectedCamp.status === 'active' ? 'paused' : 'active'})} className="w-full py-3 rounded-lg border border-[var(--border-color)] font-bold bg-[var(--bg-panel)] shadow-sm">
                     สลับเป็น {selectedCamp.status === 'active' ? 'ปิดรับชั่วคราว' : 'เปิดรับตามปกติ'}
                   </button>
                   <div className="bg-[var(--bg-panel)] p-4 rounded-xl border border-[var(--border-color)]">
                     <p className="text-xs text-[var(--text-secondary)] mb-1">เวลาเริ่มเปิดรับ</p><p className="font-bold text-[var(--text-primary)]">{selectedCamp.openTime || '-'}</p>
                     <div className="h-px w-full bg-[var(--border-color)] my-2"></div>
                     <p className="text-xs text-[var(--text-secondary)] mb-1">เวลาปิดรับ (ตัดยอด)</p><p className="font-bold text-[var(--text-danger)]">{selectedCamp.closeTime || '-'}</p>
                   </div>
                </div>
              )}
              {campTab === 'block' && (
                <div className="animate-in fade-in">
                  <div className="flex gap-2 mb-4">
                    <input type="text" value={blockInput} onChange={e=>setBlockInput(e.target.value.replace(/\D/g, ''))} className="flex-1 bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-3 text-[var(--text-primary)] outline-none" placeholder="ใส่เลขที่อั้น" />
                    <button onClick={() => { if(blockInput && !(selectedCamp.blockedNumbers||[]).includes(blockInput)){ updateActiveCamp({ ...selectedCamp, blockedNumbers: [blockInput, ...(selectedCamp.blockedNumbers||[])] }); setBlockInput(''); } }} className="bg-red-600 text-white px-4 rounded-lg font-bold">อั้นเลข</button>
                  </div>
                  <div className="grid grid-cols-4 gap-2">
                    {(selectedCamp.blockedNumbers || []).map(num => (
                      <div key={num} className="bg-red-500/10 border border-red-500/20 text-[var(--text-danger)] p-2 rounded-lg flex justify-between items-center font-bold">
                        {num} <button onClick={() => updateActiveCamp({ ...selectedCamp, blockedNumbers: selectedCamp.blockedNumbers.filter(n => n !== num) })}><i className="fas fa-trash-alt text-xs"></i></button>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {campTab === 'rate' && (
                <div className="space-y-2">
                  {Object.entries(selectedCamp.payRates || DEFAULT_PAY_RATES).map(([id, rateData]) => (
                    <div key={id} className="bg-[var(--bg-panel)] border border-[var(--border-color)] p-3 rounded-xl flex justify-between items-center shadow-sm">
                      <span className="font-bold text-[var(--text-primary)]">{rateData.name}</span>
                      <input type="number" value={rateData.pay === '' ? '' : rateData.pay} onChange={e => { const val = e.target.value; const newPay = val === '' ? '' : parseFloat(val); updateActiveCamp({ ...selectedCamp, payRates: { ...selectedCamp.payRates, [id]: { ...rateData, pay: newPay } } }); }} className="w-20 bg-[var(--bg-input)] border border-[var(--border-color)] rounded p-1.5 text-[var(--text-accent-bold)] text-right font-bold outline-none" />
                    </div>
                  ))}
                </div>
              )}
              {campTab === 'result' && (
                 <div className="animate-in fade-in">
                   <div className="bg-[var(--bg-panel)] border border-[var(--border-color)] p-5 rounded-2xl shadow-sm">
                     <div className="space-y-4">
                       <input type="text" maxLength="3" value={resultInput.top3} onChange={e=>setResultInput({...resultInput, top3: e.target.value.replace(/\D/g, '')})} placeholder="3 ตัวบน" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-4 text-center text-3xl font-mono text-[var(--text-accent-bold)] font-bold outline-none" />
                       <input type="text" maxLength="2" value={resultInput.bot2} onChange={e=>setResultInput({...resultInput, bot2: e.target.value.replace(/\D/g, '')})} placeholder="2 ตัวล่าง" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-4 text-center text-3xl font-mono text-[var(--text-accent-bold)] font-bold outline-none" />
                       <button onClick={handleProcessResults} className="w-full bg-blue-600 text-white font-bold py-4 rounded-xl shadow-md">ยืนยันผลของวันนี้ & จ่ายเงินออโต้</button>
                     </div>
                   </div>
                 </div>
              )}
            </div>
          </div>
        );
      }

      const allFilteredTickets = (ctx.betTickets || []).filter(t => {
         if(!filterDate) return true;
         if(!t || !t.createdAt) return false;
         const tDate = new Date(t.createdAt);
         const fDate = new Date(filterDate);
         return tDate.getFullYear() === fDate.getFullYear() && tDate.getMonth() === fDate.getMonth() && tDate.getDate() === fDate.getDate();
      });

      const activeTickets = allFilteredTickets.filter(t => t?.status !== 'cancelled');
      const totalBetAll = activeTickets.reduce((sum, t) => sum + (t?.totalAmount || 0), 0);
      const totalCommAll = activeTickets.reduce((sum, t) => sum + (t?.commissionEarned || 0), 0);
      const totalPayoutAll = activeTickets.reduce((sum, t) => sum + (t?.totalWin || 0), 0);
      const totalProfit = totalBetAll - totalCommAll - totalPayoutAll;

      return (
        <div className="min-h-screen bg-[var(--bg-body)] text-[var(--text-primary)] pb-20">
          <div className="bg-[var(--bg-panel)] p-4 flex justify-between items-center border-b border-[var(--border-color)] sticky top-0 z-10 shadow-sm">
            <div className="flex items-center gap-2"><div className="bg-red-600 p-1.5 rounded-lg"><i className="fas fa-cog text-white"></i></div><h1 className="font-black text-lg tracking-wider">ADMIN</h1></div>
            <div className="flex items-center gap-2">
              <ThemeToggle ctx={ctx} />
              <button onClick={() => { ctx.setUser(null); ctx.setView('login'); }} className="text-[var(--text-danger)] bg-red-500/10 px-3 py-2 rounded-lg text-sm font-bold flex items-center gap-1"><i className="fas fa-sign-out-alt"></i> ออก</button>
            </div>
          </div>

          <div className="flex bg-[var(--bg-app)] p-2 gap-2 border-b border-[var(--border-color)] overflow-x-auto">
            <button onClick={() => setAdminTab('campaigns')} className={`px-4 py-2.5 rounded-xl font-bold transition-all whitespace-nowrap ${adminTab === 'campaigns' ? 'bg-red-600 text-white shadow-md' : 'bg-[var(--bg-panel)] text-[var(--text-secondary)] border border-[var(--border-color)]'}`}>รอบหวย</button>
            <button onClick={() => setAdminTab('members')} className={`px-4 py-2.5 rounded-xl font-bold transition-all whitespace-nowrap ${adminTab === 'members' ? 'bg-blue-600 text-white shadow-md' : 'bg-[var(--bg-panel)] text-[var(--text-secondary)] border border-[var(--border-color)]'}`}>สมาชิก</button>
            <button onClick={() => setAdminTab('tickets')} className={`px-4 py-2.5 rounded-xl font-bold transition-all whitespace-nowrap ${adminTab === 'tickets' ? 'bg-green-600 text-white shadow-md' : 'bg-[var(--bg-panel)] text-[var(--text-secondary)] border border-[var(--border-color)]'}`}>ประวัติแทง</button>
            <button onClick={() => setAdminTab('system')} className={`px-4 py-2.5 rounded-xl font-bold transition-all whitespace-nowrap ${adminTab === 'system' ? 'bg-purple-600 text-white shadow-md' : 'bg-[var(--bg-panel)] text-[var(--text-secondary)] border border-[var(--border-color)]'}`}>⚙️ ระบบ</button>
          </div>

          <div className="p-4">
            {adminTab === 'campaigns' && (
              <div className="space-y-6 animate-in fade-in">
                <div className="bg-[var(--bg-panel)] p-5 rounded-2xl border border-[var(--border-color)] shadow-sm">
                  <h2 className="text-base font-bold text-[var(--text-accent-bold)] mb-3">สร้างรอบหวยใหม่ (ทำงานรายวัน)</h2>
                  <form onSubmit={handleAddCampaign} className="space-y-3">
                    <input type="text" value={newCampaign.name} onChange={e => setNewCampaign({...newCampaign, name: e.target.value})} placeholder="ชื่อหวย เช่น หวยลาว" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-3 text-[var(--text-primary)] text-sm outline-none" />
                    <div className="grid grid-cols-2 gap-2">
                      <div><label className="text-[10px] text-[var(--text-secondary)] ml-1">เวลาเริ่ม (HH:mm)</label><input type="time" value={newCampaign.openTime} onChange={e => setNewCampaign({...newCampaign, openTime: e.target.value})} className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-2 text-[var(--text-primary)] text-sm outline-none font-mono" /></div>
                      <div><label className="text-[10px] text-[var(--text-secondary)] ml-1">เวลาปิดรับ (HH:mm)</label><input type="time" value={newCampaign.closeTime} onChange={e => setNewCampaign({...newCampaign, closeTime: e.target.value})} className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-2 text-[var(--text-primary)] text-sm outline-none font-mono" /></div>
                    </div>
                    <button type="submit" className="w-full bg-yellow-500 text-black font-bold py-2.5 rounded-lg text-sm shadow-md">สร้างหวย</button>
                  </form>
                </div>

                <div>
                  <h3 className="font-bold text-[var(--text-primary)] mb-3 text-sm">จัดการหวย (กดเพื่อตั้งค่า)</h3>
                  <div className="space-y-3">
                    {(ctx.campaigns || []).map(camp => {
                      if(!camp) return null;
                      return (
                      <div key={camp.id} className="w-full bg-[var(--bg-panel)] rounded-xl border border-[var(--border-color)] flex items-center shadow-sm overflow-hidden">
                        <button onClick={() => { setSelectedCamp(camp); setCampTab('info'); }} className="flex-1 p-4 flex justify-between items-center text-left hover:bg-[var(--bg-input)] transition-colors">
                          <div>
                            <h4 className="font-bold text-[var(--text-primary)]">{camp.name}</h4>
                            <p className="text-[11px] text-[var(--text-secondary)] mt-1">อั้น: {(camp.blockedNumbers || []).length} | {camp.status === 'active' ? `เปิดทุกวัน: ${camp.openTime}-${camp.closeTime}` : 'ถูกปิดชั่วคราว'}</p>
                          </div>
                          <i className="fas fa-chevron-right text-[var(--text-muted)]"></i>
                        </button>
                        <button onClick={() => handleDeleteCampaign(camp.id)} className="p-4 bg-red-500/10 hover:bg-red-500/20 text-red-500 transition-colors h-full flex items-center justify-center">
                           <i className="fas fa-trash-alt"></i>
                        </button>
                      </div>
                      )
                    })}
                    {(ctx.campaigns || []).length === 0 && <div className="text-center text-[var(--text-muted)] p-4">ยังไม่ได้สร้างหวย</div>}
                  </div>
                </div>
              </div>
            )}

            {adminTab === 'members' && (
              <div className="animate-in fade-in space-y-6">
                 <div className="bg-[var(--bg-panel)] p-5 rounded-2xl border border-[var(--border-color)] shadow-sm">
                  <h2 className="text-base font-bold text-[var(--text-info)] mb-3">สร้างสมาชิก/เอเย่นต์</h2>
                  <form onSubmit={handleCreateUser} className="space-y-3">
                    <div className="grid grid-cols-2 gap-2">
                      <input type="text" value={newUser.username} onChange={e => setNewUser({...newUser, username: e.target.value})} placeholder="Username" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-3 text-sm outline-none text-[var(--text-primary)]" />
                      <input type="text" value={newUser.password} onChange={e => setNewUser({...newUser, password: e.target.value})} placeholder="Password" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-3 text-sm outline-none text-[var(--text-primary)]" />
                    </div>
                    <input type="text" value={newUser.name} onChange={e => setNewUser({...newUser, name: e.target.value})} placeholder="ชื่อลูกค้า" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-3 text-sm outline-none text-[var(--text-primary)]" />
                    <input type="number" value={newUser.credit} onChange={e => setNewUser({...newUser, credit: e.target.value})} placeholder="เครดิตเริ่มต้น" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded-lg p-3 text-[var(--text-accent-bold)] font-bold outline-none" />
                    
                    <button type="button" onClick={() => setShowNewCommSetup(!showNewCommSetup)} className="w-full py-2 bg-[var(--bg-input)] text-[var(--text-secondary)] border border-[var(--border-color)] rounded-lg text-xs font-bold hover:text-[var(--text-primary)]">
                      {showNewCommSetup ? 'ซ่อนตั้งค่าค่าคอมมิชชั่น' : '⚙️ ตั้งค่าค่าคอมมิชชั่นรายประเภท'}
                    </button>
                    
                    {showNewCommSetup && (
                      <div className="grid grid-cols-2 gap-2 bg-[var(--bg-body)] p-3 rounded-lg border border-[var(--border-color)]">
                        {Object.keys(DEFAULT_COMM_RATES).map(k => (
                          <div key={k} className="flex items-center gap-2">
                            <span className="text-[10px] text-[var(--text-secondary)] w-12">{DEFAULT_PAY_RATES[k].name}</span>
                            <input type="number" value={newUser.commRates[k] === 0 ? '' : newUser.commRates[k]} onChange={(e) => setNewUser({...newUser, commRates: {...newUser.commRates, [k]: parseFloat(e.target.value)||0}})} placeholder="0%" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded p-1.5 text-xs text-[var(--text-primary)] outline-none" />
                          </div>
                        ))}
                      </div>
                    )}

                    <button type="submit" className="w-full bg-blue-600 text-white font-bold py-2.5 rounded-lg text-sm shadow-md mt-2">บันทึกสมาชิก</button>
                  </form>
                </div>
                <div>
                  <h3 className="font-bold text-[var(--text-primary)] mb-3 text-sm">รายชื่อสมาชิกและจัดการ</h3>
                  {(ctx.usersDb || []).filter(u => u?.role !== 'admin').map(u => {
                    if(!u) return null;
                    const userCommRates = u.commRates || {};
                    const hasComm = Object.values(userCommRates).some(v => (parseFloat(v)||0) > 0);
                    return (
                      <div key={u.uid} className="bg-[var(--bg-panel)] p-3 rounded-xl border border-[var(--border-color)] mb-2 shadow-sm">
                        <div className="flex justify-between items-center">
                          <div>
                            <span className="font-bold text-[var(--text-info)] text-sm">{u.username}</span>
                            <div className="text-xs text-[var(--text-secondary)] mt-0.5">{u.name} (Pass: {u.password})</div>
                            {hasComm && <div className="text-[9px] text-green-500 font-bold mt-1 bg-green-500/10 inline-block px-1.5 rounded">รับค่าคอมรายประเภท</div>}
                          </div>
                          <div className="text-right flex flex-col items-end">
                            <span className="text-[var(--text-accent-bold)] font-bold text-sm mb-1">฿ {(u.credit||0).toLocaleString()}</span>
                            <button onClick={() => { 
                              if (editingUser === u.uid) { setEditingUser(null); } 
                              else { setEditingUser(u.uid); setCustomCreditAmount(''); setEditingCommRates(u.commRates || DEFAULT_COMM_RATES); }
                            }} className="text-xs bg-[var(--bg-input)] text-[var(--text-primary)] px-2 py-1 rounded flex items-center gap-1 border border-[var(--border-color)]"><i className="fas fa-edit"></i> ตั้งค่า</button>
                          </div>
                        </div>
                        
                        {editingUser === u.uid && (
                          <div className="mt-3 pt-3 border-t border-[var(--border-color)] flex flex-col gap-3 animate-in slide-in-from-top-2">
                            <div className="flex gap-2">
                              <input type="number" value={customCreditAmount} onChange={(e) => setCustomCreditAmount(e.target.value)} placeholder="เงินเครดิต..." className="flex-1 bg-[var(--bg-input)] border border-[var(--border-color)] rounded p-2 text-sm text-[var(--text-primary)] outline-none" />
                              <button onClick={() => { const amt = parseFloat(customCreditAmount); if(!isNaN(amt) && amt > 0) handleUpdateCredit(u.uid, amt); }} className="bg-green-500/20 text-[var(--text-success)] px-3 py-2 rounded font-bold text-xs hover:bg-green-500/30 transition-colors">+ เพิ่ม</button>
                              <button onClick={() => { const amt = parseFloat(customCreditAmount); if(!isNaN(amt) && amt > 0) handleUpdateCredit(u.uid, -amt); }} className="bg-red-500/20 text-[var(--text-danger)] px-3 py-2 rounded font-bold text-xs hover:bg-red-500/30 transition-colors">- ลด</button>
                            </div>
                            
                            <div className="bg-[var(--bg-body)] p-3 rounded-xl border border-[var(--border-color)]">
                              <p className="text-[10px] text-blue-500 font-bold mb-2">แก้ไขค่าคอมมิชชั่น (%)</p>
                              <div className="grid grid-cols-2 gap-2 mb-3">
                                {Object.keys(DEFAULT_COMM_RATES).map(k => (
                                  <div key={k} className="flex items-center gap-2">
                                    <span className="text-[10px] text-[var(--text-secondary)] w-12">{DEFAULT_PAY_RATES[k].name}</span>
                                    <input type="number" value={editingCommRates?.[k] === 0 ? '' : (editingCommRates?.[k] || '')} onChange={(e) => setEditingCommRates({...editingCommRates, [k]: parseFloat(e.target.value)||0})} placeholder="0" className="w-full bg-[var(--bg-input)] border border-[var(--border-color)] rounded p-1.5 text-xs text-[var(--text-primary)] outline-none" />
                                  </div>
                                ))}
                              </div>
                              <button onClick={() => handleUpdateComm(u.uid)} className="w-full bg-blue-500/20 text-[var(--text-info)] px-3 py-2 rounded font-bold text-xs">บันทึกค่าคอม</button>
                            </div>

                            <div className="flex justify-between items-center mt-1 px-1">
                              <button onClick={() => { if(window.confirm(`ต้องการตัดเครดิตของ ${u.username} ให้เหลือ 0 ใช่หรือไม่?`)) { handleUpdateCredit(u.uid, -u.credit); } }} className="text-[var(--text-danger)] text-xs underline font-medium">ถอนทั้งหมด (เหลือ 0)</button>
                              <button onClick={() => setEditingUser(null)} className="text-[var(--text-muted)] text-xs underline">ปิด</button>
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })}
              {(ctx.usersDb || []).filter(u => u?.role !== 'admin').length === 0 && <div className="text-center text-[var(--text-muted)] p-4">ยังไม่มีสมาชิก</div>}
            </div>
          </div>
        )}

        {adminTab === 'tickets' && (
          <div className="animate-in fade-in space-y-4">
            <div className="bg-[var(--bg-panel)] p-3 border border-[var(--border-color)] rounded-xl mb-4 shadow-sm">
               <div className="flex items-center gap-2">
                 <label className="text-sm font-bold text-[var(--text-secondary)]">ดูยอดของวันที่:</label>
                 <input type="date" value={filterDate} onChange={(e) => setFilterDate(e.target.value)} className="flex-1 bg-[var(--bg-input)] border border-[var(--border-color)] text-[var(--text-primary)] p-2 rounded-lg text-sm outline-none" />
                 {filterDate && <button onClick={() => setFilterDate('')} className="bg-red-500/10 text-red-500 px-3 py-2 rounded-lg text-xs font-bold">ดูทั้งหมด</button>}
               </div>
            </div>

            <div className="bg-[var(--bg-panel)] p-4 rounded-xl border border-[var(--border-color)] flex justify-between items-center shadow-sm">
              <div><p className="text-xs text-[var(--text-secondary)]">แทงรวม</p><p className="font-bold text-[var(--text-primary)]">฿ {totalBetAll.toLocaleString()}</p></div>
              <div><p className="text-xs text-[var(--text-secondary)]">คอม+จ่ายรวม</p><p className="font-bold text-[var(--text-danger)]">฿ {(totalPayoutAll+totalCommAll).toLocaleString()}</p></div>
              <div className="text-right"><p className="text-xs text-[var(--text-secondary)]">กำไรเว็บสุทธิ</p><p className={`font-black text-lg ${totalProfit >= 0 ? 'text-[var(--text-success)]' : 'text-[var(--text-danger)]'}`}>฿ {totalProfit.toLocaleString()}</p></div>
            </div>

            <div className="space-y-3">
              {allFilteredTickets.slice().reverse().map(ticket => {
                 if(!ticket) return null;
                 const camp = (ctx.campaigns || []).find(c => c?.id === ticket.campaignId);
                 const isCancelled = ticket.status === 'cancelled';
                 return (
                  <div key={ticket.id} className={`bg-[var(--bg-panel)] p-3 rounded-xl border border-[var(--border-color)] text-sm shadow-sm ${isCancelled ? 'opacity-50' : ''}`}>
                    <div className="flex justify-between border-b border-[var(--border-color)] pb-2 mb-2">
                      <span className="text-[var(--text-secondary)]">ยูส: <b className="text-[var(--text-primary)]">{ticket.username}</b></span>
                      <span className={isCancelled ? 'text-gray-500' : ticket.status === 'processed' ? 'text-[var(--text-success)]' : 'text-[var(--text-accent-bold)]'}>{isCancelled ? 'ยกเลิกแล้ว' : ticket.status === 'processed' ? 'ออกผลแล้ว' : 'รอออกผล'}</span>
                    </div>
                    <div className="text-[var(--text-primary)] font-bold mb-1">{camp?.name || 'ไม่ทราบรอบหวย'}</div>
                    <div className="flex justify-between text-xs text-[var(--text-secondary)]">
                      <span>ยอดแทง: <b className="text-[var(--text-accent-bold)]">฿{ticket.totalAmount}</b></span>
                      <span>ส่วนลด: <b className="text-green-500">฿{ticket.commissionEarned || 0}</b></span>
                    </div>
                    {ticket.status === 'processed' && (
                      <div className="mt-2 pt-2 border-t border-[var(--border-color)] text-right">
                        <span className="text-xs text-[var(--text-secondary)] mr-2">ถูกรางวัล:</span>
                        <span className={`font-bold ${ticket.totalWin > 0 ? 'text-[var(--text-success)]' : 'text-[var(--text-muted)]'}`}>฿{(ticket.totalWin||0).toLocaleString()}</span>
                      </div>
                    )}
                  </div>
                 )
              })}
              {allFilteredTickets.length === 0 && <div className="text-center text-[var(--text-muted)] p-4">ไม่มีประวัติการแทงของวันที่เลือก</div>}
            </div>
          </div>
        )}

        {adminTab === 'system' && (
          <div className="animate-in fade-in space-y-6">
             <div className="bg-[var(--bg-panel)] p-6 rounded-2xl border border-[var(--border-color)] shadow-sm text-center">
                <i className="fas fa-database text-[var(--text-info)] text-5xl mb-4"></i>
                <h2 className="text-lg font-bold text-[var(--text-primary)] mb-2">ระบบฐานข้อมูล (Local DB)</h2>
                <p className="text-xs text-[var(--text-secondary)] mb-6">ข้อมูลจะถูกบันทึกอัตโนมัติบนเบราว์เซอร์</p>
                <div className="grid grid-cols-3 gap-2 text-center text-sm border-t border-[var(--border-color)] py-4">
                  <div><p className="font-bold text-[var(--text-primary)]">{(ctx.usersDb || []).filter(u=>u?.role!=='admin').length}</p><p className="text-xs text-[var(--text-secondary)]">สมาชิก</p></div>
                  <div><p className="font-bold text-[var(--text-primary)]">{(ctx.campaigns || []).length}</p><p className="text-xs text-[var(--text-secondary)]">รอบหวย</p></div>
                  <div><p className="font-bold text-[var(--text-primary)]">{(ctx.betTickets || []).length}</p><p className="text-xs text-[var(--text-secondary)]">โพย</p></div>
                </div>
             </div>

             <div className="bg-orange-950/20 p-6 rounded-2xl border border-orange-500/50 shadow-sm text-center mt-4">
                <i className="fas fa-broom text-orange-500 text-4xl mb-2"></i>
                <h2 className="text-base font-bold text-orange-500 mb-2">ล้างประวัติเก่า (Clear Cache)</h2>
                <p className="text-xs text-orange-400 mb-6 opacity-80">ปุ่มนี้จะลบเฉพาะ "โพยเก่า" และ "ผลรางวัลเก่า" ทิ้งทั้งหมด เพื่อให้ระบบทำงานเร็วขึ้น (เครดิต, สมาชิก, และรายชื่อหวยจะยังอยู่ครบ)</p>
                <button onClick={handleClearHistory} className="w-full bg-orange-600 text-white font-bold py-3.5 rounded-xl shadow-lg hover:bg-orange-700 transition-colors">
                  ล้างประวัติเก่าทั้งหมด
                </button>
             </div>

             <div className="bg-red-950/20 p-6 rounded-2xl border border-red-500/50 shadow-sm text-center mt-4">
                <i className="fas fa-exclamation-triangle text-[var(--text-danger)] text-4xl mb-2"></i>
                <h2 className="text-base font-bold text-[var(--text-danger)] mb-2">อันตราย: ล้างข้อมูลโรงงาน</h2>
                <p className="text-xs text-[var(--text-danger)] mb-6 opacity-80">ปุ่มนี้จะลบข้อมูลทุกอย่างในระบบกลับเป็นศูนย์ (ข้อมูลแอดมิน, สมาชิก, หวย, โพย จะหายหมด)</p>
                <button onClick={handleFactoryReset} className="w-full bg-red-600 text-white font-bold py-3.5 rounded-xl shadow-lg hover:bg-red-700 transition-colors">
                  ล้างระบบทั้งหมด (Factory Reset)
                </button>
             </div>
          </div>
        )}
      </div>
    </div>
  );
};

const BottomNav = ({ ctx }) => (
  <div className="fixed bottom-0 w-full max-w-md bg-[var(--bg-panel)] border-t border-[var(--border-color)] flex justify-around items-center pt-2 px-2 z-30 pb-4 shadow-2xl transition-colors">
    <button onClick={() => ctx.setView('home')} className={`flex flex-col items-center p-2 transition-transform ${ctx.view === 'home' ? 'text-[var(--text-accent-bold)] scale-110' : 'text-[var(--text-muted)]'}`}><i className="fas fa-home text-xl"></i><span className="text-[10px] mt-1 font-medium">หน้าหลัก</span></button>
    <button onClick={() => ctx.setView('user_tickets')} className={`flex flex-col items-center p-2 transition-transform ${ctx.view === 'user_tickets' ? 'text-[var(--text-accent-bold)] scale-110' : 'text-[var(--text-muted)]'}`}><i className="fas fa-file-invoice text-xl"></i><span className="text-[10px] mt-1 font-medium">โพยหวย</span></button>
    <div className="relative -top-6">
      <button onClick={() => ctx.setView('contact')} className="w-14 h-14 bg-gradient-to-tr from-blue-600 to-blue-800 rounded-full flex items-center justify-center text-white shadow-lg shadow-blue-900/50 border-4 border-[var(--bg-app)] transition-transform hover:scale-105"><i className="fas fa-comment-dots text-2xl"></i></button>
    </div>
    <button onClick={() => ctx.setView('results')} className={`flex flex-col items-center p-2 transition-transform ${ctx.view === 'results' ? 'text-[var(--text-success)] scale-110' : 'text-[var(--text-muted)]'}`}><i className="fas fa-medal text-xl"></i><span className="text-[10px] mt-1 font-medium">ผลรางวัล</span></button>
    <button onClick={() => { ctx.setUser(null); ctx.setView('login'); }} className="flex flex-col items-center p-2 text-[var(--text-danger)] opacity-80 hover:opacity-100"><i className="fas fa-sign-out-alt text-xl"></i><span className="text-[10px] mt-1 font-medium">ออกระบบ</span></button>
  </div>
);

// MAIN APP
function App() {
  const [isDarkMode, setIsDarkMode] = usePersistentStorage('VIP_THEME', true);
  const [usersDb, setUsersDb] = usePersistentStorage('VIP_USERS', []);
  const [campaigns, setCampaigns] = usePersistentStorage('VIP_CAMPAIGNS', []);
  const [betTickets, setBetTickets] = usePersistentStorage('VIP_TICKETS', []);
  const [timeDefaults, setTimeDefaults] = usePersistentStorage('VIP_TIME_DEFAULTS', { openTime: '', closeTime: '' });

  const [user, setUser] = useState(null); 
  const [view, setView] = useState('login'); 
  const [cart, setCart] = useState([]);
  const [notification, setNotification] = useState('');
  const [activeCampaign, setActiveCampaign] = useState(null);

  const showNotification = (msg) => {
    setNotification(msg);
    setTimeout(() => setNotification(''), 3000);
  };

  const ctx = {
    isDarkMode, setIsDarkMode,
    usersDb, setUsersDb,
    campaigns, setCampaigns,
    betTickets, setBetTickets,
    timeDefaults, setTimeDefaults,
    user, setUser,
    view, setView,
    cart, setCart,
    activeCampaign, setActiveCampaign,
    showNotification
  };

  return (
    <div className={`theme-${isDarkMode ? 'dark' : 'light'} bg-[var(--bg-body)] min-h-screen text-[var(--text-primary)] font-sans selection:bg-red-500 flex justify-center transition-colors duration-300`}>
      <div className="w-full max-w-md bg-[var(--bg-app)] min-h-screen relative overflow-hidden shadow-2xl">
        {notification && (
          <div className="absolute top-4 left-1/2 -translate-x-1/2 z-50 bg-[var(--bg-panel)] border border-[var(--border-color)] text-[var(--text-accent-bold)] px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 animate-in w-max max-w-[90%]">
            <i className="fas fa-exclamation-circle"></i>
            <span className="text-sm font-bold">{notification}</span>
          </div>
        )}

        {view === 'login' && <LoginView ctx={ctx} />}
        {view === 'home' && <HomeView ctx={ctx} />}
        {view === 'lotto' && <LottoView ctx={ctx} />}
        {view === 'cart' && <CartView ctx={ctx} />}
        {view === 'admin' && <AdminView ctx={ctx} />}
        {view === 'user_tickets' && <UserTicketsView ctx={ctx} />}
        {view === 'sales' && <SalesSummaryView ctx={ctx} />}
        {view === 'results' && <ResultsView ctx={ctx} />}
        {view === 'contact' && <ContactView ctx={ctx} />}

        {user && user.role !== 'admin' && !['login', 'cart'].includes(view) && <BottomNav ctx={ctx} />}
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
  </script>
</body>
</html>
